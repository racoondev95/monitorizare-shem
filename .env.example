# Copiază acest fișier în `.env` și schimbă valorile.
DB_PASSWORD=schimba-parola-db
SESSION_SECRET=un-sir-lung-si-aleator-de-minim-32-de-caractere

# Contul de administrator creat automat la prima pornire
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=schimba-parola-admin
ADMIN_NAME=Administrator

APP_PORT=3000
APP_TIMEZONE=Europe/Bucharest
# Pune true când aplicația rulează în spatele HTTPS
COOKIE_SECURE=false

# Doar pentru `npm run dev` (baza de date din Docker, port expus pe localhost)
DATABASE_URL=postgres://shem:schimba-parola-db@localhost:5432/shem
